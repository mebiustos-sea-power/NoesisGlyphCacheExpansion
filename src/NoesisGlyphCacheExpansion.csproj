<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NoesisGlyphCacheExpansion</AssemblyName>
    <RootNamespace>NoesisGlyphCacheExpansion</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AnchorChain" HintPath="$(AnchorChainDir)\AnchorChain.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(SeaPowerDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SeaPowerDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Noesis.NoesisGUI" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\Noesis.NoesisGUI.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AnchorChainDir)\AnchorChain.dll')" Text="AnchorChain.dll not found. Set AnchorChainDir in Directory.Build.local.props." />
    <Error Condition="!Exists('$(SeaPowerDir)\BepInEx\core\BepInEx.dll')" Text="BepInEx.dll not found. Set SeaPowerDir in Directory.Build.local.props." />
    <Error Condition="!Exists('$(SeaPowerDir)\BepInEx\core\0Harmony.dll')" Text="0Harmony.dll not found. Check SeaPowerDir." />
    <Error Condition="!Exists('$(SeaPowerDir)\Sea Power_Data\Managed\Noesis.NoesisGUI.dll')" Text="Noesis.NoesisGUI.dll not found. Check SeaPowerDir." />
    <Error Condition="!Exists('$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll not found. Check SeaPowerDir." />
  </Target>
</Project>
